fig_anim, ax_anim = plt.subplots(figsize=(10, 6))
linhas = []
for (nome, (tamanhos, medias, _)), cor in zip(medicoes.items(), cores):
    referencia = medias[0]
    (linha,) = ax_anim.plot([], [], "o-", label=f"{nome} - {descricoes[nome]}", color=cor)
    linhas.append((linha, tamanhos, [media / referencia for media in medias]))
ax_anim.set_xscale("log")
ax_anim.set_yscale("log")
ax_anim.set_xlim(4, 500)
ax_anim.set_ylim(0.5, 1e7)
ax_anim.set_xlabel("Tamanho da entrada (n)")
ax_anim.set_ylabel("Crescimento relativo")
ax_anim.set_title("Crescimento relativo das complexidades")
ax_anim.grid(True, which="both", alpha=0.3)
ax_anim.legend().set_visible(False)


def atualizar(indice):
    linhas_visiveis = []
    for linha, tamanhos, valores in linhas:
        limite = min(indice + 1, len(tamanhos))
        linha.set_data(tamanhos[:limite], valores[:limite])
        linha.set_visible(indice >= linhas.index((linha, tamanhos, valores)))
        if linha.get_visible():
            linhas_visiveis.append(linha)
    ax_anim.legend(handles=linhas_visiveis, labels=[linha.get_label() for linha in linhas_visiveis])
    return [linha for linha, _, _ in linhas]


animacao = FuncAnimation(fig_anim, atualizar, frames=len(linhas), interval=900, blit=False)
animacao.save("complexidades.gif", writer="pillow", fps=1)
