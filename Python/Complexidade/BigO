}

crescimentos = {
    "O(1)": lambda n: 1,
    "O(log n)": lambda n: math.log2(n),
    "O(n)": lambda n: n,
    "O(n log n)": lambda n: n * math.log2(n),
    "O(n log n) - quicksort": lambda n: n * __import__("math").log2(n),
    "O(n^2)": lambda n: n**2,
    "O(n^3)": lambda n: n**3,
    "O(2^n)": lambda n: 2**n,
    "O(n) Fibonacci memo": lambda n: n,
    "O(n^log2(7)) Strassen": lambda n: n ** math.log2(7),
}

cores = [
    "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728",
    "#9467bd", "#8c564b", "#e377c2", "#17becf",
