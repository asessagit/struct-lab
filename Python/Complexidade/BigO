"""Benchmark visual de complexidades Big-O."""

import csv
import math
import statistics
import timeit

import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation


def constante(n):
    """Operacao independente do tamanho da entrada: O(1)."""
    return n


def busca_binaria(n):
    """Busca binaria em um intervalo ordenado: O(log n)."""
    inicio, fim = 0, n - 1
    alvo = -1
    while inicio <= fim:
        meio = (inicio + fim) // 2
        if meio == alvo:
            return meio
        if meio < alvo:
            inicio = meio + 1
        else:
            fim = meio - 1
    return -1


def linear(n):
    """Percorre a entrada uma vez: O(n)."""
    total = 0
    for _ in range(n):
        total += 1
    return total


def merge_sort(n):
    """Ordena uma lista usando merge sort: O(n log n)."""
    valores = list(range(n, 0, -1))

    def ordenar(itens):
        if len(itens) <= 1:
            return itens
        meio = len(itens) // 2
        esquerda = ordenar(itens[:meio])
        direita = ordenar(itens[meio:])
        resultado = []
        indice_esquerda = indice_direita = 0
        while indice_esquerda < len(esquerda) and indice_direita < len(direita):
            if esquerda[indice_esquerda] <= direita[indice_direita]:
                resultado.append(esquerda[indice_esquerda])
                indice_esquerda += 1
            else:
                resultado.append(direita[indice_direita])
                indice_direita += 1
        return resultado + esquerda[indice_esquerda:] + direita[indice_direita:]

    return ordenar(valores)


def quicksort(n):
    """Ordena usando quicksort: O(n log n) em media e O(n^2) no pior caso."""
    valores = list(range(n, 0, -1))

    def ordenar(itens):
        if len(itens) <= 1:
            return itens
        pivo = itens[len(itens) // 2]
        menores = [item for item in itens if item < pivo]
        iguais = [item for item in itens if item == pivo]
        maiores = [item for item in itens if item > pivo]
        return ordenar(menores) + iguais + ordenar(maiores)

    return ordenar(valores)


def quadratica(n):
    """Percorre a entrada duas vezes: O(n^2)."""
    total = 0
    for _ in range(n):
        for _ in range(n):
            total += 1
    return total


def cubica(n):
    """Executa tres lacos aninhados: O(n^3), como uma multiplicacao de matrizes."""
    total = 0
    for _ in range(n):
        for _ in range(n):
            for _ in range(n):
                total += 1
    return total


def exponencial(n):
    """Recorrencia sem memoizacao: O(2^n)."""
    if n <= 1:
        return 1
    return exponencial(n - 1) + exponencial(n - 2)


def fibonacci_memo(n):
    """Calcula Fibonacci com memoizacao: O(n) em tempo e O(n) em memoria."""
    memoria = [0, 1]
    for indice in range(2, n + 1):
        memoria.append(memoria[-1] + memoria[-2])
    return memoria[n]


def somar_matrizes(esquerda, direita):
    return [
        [valor_esquerda + valor_direita for valor_esquerda, valor_direita in zip(linha_esquerda, linha_direita)]
        for linha_esquerda, linha_direita in zip(esquerda, direita)
    ]


def subtrair_matrizes(esquerda, direita):
    return [
        [valor_esquerda - valor_direita for valor_esquerda, valor_direita in zip(linha_esquerda, linha_direita)]
        for linha_esquerda, linha_direita in zip(esquerda, direita)
    ]


def strassen(n):
    """Multiplica matrizes por Strassen: O(n^log2(7))."""
    esquerda = [[1] * n for _ in range(n)]
    direita = [[2] * n for _ in range(n)]

    def multiplicar(matriz_a, matriz_b):
        tamanho = len(matriz_a)
        if tamanho == 1:
            return [[matriz_a[0][0] * matriz_b[0][0]]]
        meio = tamanho // 2
        a11 = [linha[:meio] for linha in matriz_a[:meio]]
        a12 = [linha[meio:] for linha in matriz_a[:meio]]
        a21 = [linha[:meio] for linha in matriz_a[meio:]]
        a22 = [linha[meio:] for linha in matriz_a[meio:]]
        b11 = [linha[:meio] for linha in matriz_b[:meio]]
        b12 = [linha[meio:] for linha in matriz_b[:meio]]
        b21 = [linha[:meio] for linha in matriz_b[meio:]]
        b22 = [linha[meio:] for linha in matriz_b[meio:]]

        p1 = multiplicar(a11, subtrair_matrizes(b12, b22))
        p2 = multiplicar(somar_matrizes(a11, a12), b22)
        p3 = multiplicar(somar_matrizes(a21, a22), b11)
        p4 = multiplicar(a22, subtrair_matrizes(b21, b11))
        p5 = multiplicar(somar_matrizes(a11, a22), somar_matrizes(b11, b22))
        p6 = multiplicar(subtrair_matrizes(a12, a22), somar_matrizes(b21, b22))
        p7 = multiplicar(subtrair_matrizes(a11, a21), somar_matrizes(b11, b12))

        c11 = somar_matrizes(subtrair_matrizes(somar_matrizes(p5, p4), p2), p6)
        c12 = somar_matrizes(p1, p2)
        c21 = somar_matrizes(p3, p4)
        c22 = somar_matrizes(subtrair_matrizes(somar_matrizes(p5, p1), p3), p7)
        return [
            esquerda + direita
            for esquerda, direita in zip(
                [linha_a + linha_b for linha_a, linha_b in zip(c11, c12)],
                [linha_a + linha_b for linha_a, linha_b in zip(c21, c22)],
            )
        ]

    return multiplicar(esquerda, direita)


def medir(funcao, tamanhos, repeticoes, amostras=5):
    """Retorna medias e desvios-padrao de varias amostras."""
    medias = []
    desvios = []
    for tamanho in tamanhos:
        resultados = [
            timeit.timeit(lambda: funcao(tamanho), number=repeticoes)
            for _ in range(amostras)
        ]
        medias.append(statistics.mean(resultados))
        desvios.append(statistics.stdev(resultados) if amostras > 1 else 0.0)
    return medias, desvios


configuracoes = [
    ("O(1)", constante, [10, 25, 50, 100, 200, 400], 100_000),
    ("O(log n)", busca_binaria, [10, 25, 50, 100, 200, 400], 100_000),
    ("O(n)", linear, [10, 25, 50, 100, 200, 400], 1_000),
    ("O(n log n)", merge_sort, [10, 25, 50, 100, 200, 400], 10),
    ("O(n log n) - quicksort", quicksort, [10, 25, 50, 100, 200, 400], 10),
    ("O(n^2)", quadratica, [10, 25, 50, 100, 200, 400], 10),
    ("O(n^3)", cubica, [10, 25, 50, 100, 200], 1),
    ("O(2^n)", exponencial, [5, 10, 15, 20, 25], 1),
    ("O(n) Fibonacci memo", fibonacci_memo, [10, 25, 50, 100, 200, 400], 10_000),
    ("O(n^log2(7)) Strassen", strassen, [2, 4, 8, 16], 1),
]

medicoes = {}
for nome, funcao, tamanhos, repeticoes in configuracoes:
    medicoes[nome] = (tamanhos, *medir(funcao, tamanhos, repeticoes))

with open("complexidades.csv", "w", newline="", encoding="utf-8") as arquivo:
    escritor = csv.writer(arquivo)
    escritor.writerow([
        "complexidade", "n", "tempo_medio_s", "desvio_padrao_s",
        "tempo_normalizado", "desvio_normalizado",
    ])
    for nome, (tamanhos, medias, desvios) in medicoes.items():
        referencia = medias[0]
        escritor.writerows(
            [nome, tamanho, media, desvio, media / referencia, desvio / referencia]
            for tamanho, media, desvio in zip(tamanhos, medias, desvios)
        )

