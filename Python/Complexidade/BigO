fig_norm, ax_norm = plt.subplots(figsize=(10, 6))
for (nome, (tamanhos, medias, desvios)), cor in zip(medicoes.items(), cores):
    referencia = medias[0]
    desvios_normalizados = [desvio / referencia for desvio in desvios]
    ax_norm.errorbar(
        tamanhos,
        [media / referencia for media in medias],
        yerr=desvios_normalizados,
        fmt="o-",
        capsize=3,
        label=f"{nome} - medido",
        color=cor,
    )
    teoria = [crescimentos[nome](tamanho) / crescimentos[nome](tamanhos[0]) for tamanho in tamanhos]
    ax_norm.plot(tamanhos, teoria, "--", color=cor, alpha=0.8, label=f"{nome} - teoria")
ax_norm.set_xscale("log")
ax_norm.set_yscale("log")
ax_norm.set_xlabel("Tamanho da entrada (n)")
ax_norm.set_ylabel("Crescimento relativo (primeiro ponto = 1)")
